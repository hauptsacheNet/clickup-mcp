# Incrementum hardened .npmrc (npm variant)
# Block lifecycle scripts — neutralizes the #1 npm malware delivery vector.
ignore-scripts=true

# 7-day cooldown — refuse versions younger than 7 days. Requires npm 11+.
min-release-age=7

# Enforce lockfile presence on `npm install` (no effect on `npm ci`).
package-lock=true

# Fail loud on high/critical advisories during `npm audit`.
audit-level=high
